#include <winver.h>
IDI_ICON1 ICON "mobilador.ico"
1 24 "mobilador.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604b0"
    BEGIN
      VALUE "CompanyName", "Mobilador"
      VALUE "FileDescription", "MOBILADOR - Android Gaming Bridge"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "MOBILADOR"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "Mobilador.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
